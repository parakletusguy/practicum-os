# ==============================================================================
# PracticumOS Production Environment Configuration Template
# PostgreSQL 17 on Supabase (Pooler vs Direct Connection Configuration)
# ==============================================================================

# Supabase Transaction Connection Pooler (PgBouncer - Port 6543)
# Use for application queries & server actions in serverless environments (e.g. Vercel)
DATABASE_URL="postgresql://postgres.nyqncmddflybdqrkuafy:[YOUR_PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&sslmode=require"

# For Prisma migrations, prefer the direct URL from Supabase Connect on hosts
# with IPv6. This session-pooler fallback works on IPv4-only hosts; always copy
# the current host/user from the Supabase dashboard rather than composing it.
DIRECT_URL="postgresql://postgres.nyqncmddflybdqrkuafy:[YOUR_PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require"

# Production App Domain URL
NEXT_PUBLIC_APP_URL="https://practicum-os.vercel.app"

# Storage & Privacy Sanitizer
NEXT_PUBLIC_SUPABASE_URL="https://nyqncmddflybdqrkuafy.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR_PUBLISHABLE_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# Keep demo persona controls disabled in production.
PRACTICUM_DEMO_MODE="false"

# System Safeguarding & Audit
NODE_ENV="production"
PRACTICUM_AUDIT_ENABLED="true"
SCOPEGUARD_ENFORCEMENT_LEVEL="STRICT"

# Used by the production scheduler to authorize /api/cron/early-warnings.
# Generate a unique value of 16+ random characters and store it only in Vercel.
CRON_SECRET="[GENERATE_A_RANDOM_SECRET]"
