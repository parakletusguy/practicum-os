# ==============================================================================
# PracticumOS Production Environment Configuration Template
# PostgreSQL 17 on Supabase (Pooler vs Direct Connection Configuration)
# ==============================================================================

# Supabase Transaction Connection Pooler (PgBouncer - Port 6543)
# Use for application queries & server actions in serverless environments (e.g. Vercel)
DATABASE_URL="postgresql://postgres.nyqncmddflybdqrkuafy:[YOUR_PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"

# Supabase Direct Connection (Session / Migrations - Port 5432)
# Required by Prisma for db push, migrations, and schema introspection
DIRECT_URL="postgresql://postgres.nyqncmddflybdqrkuafy:[YOUR_PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Production App Domain URL
NEXT_PUBLIC_APP_URL="https://practicum-os.vercel.app"

# Storage & Privacy Sanitizer
NEXT_PUBLIC_SUPABASE_URL="https://nyqncmddflybdqrkuafy.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_ANON_PUBLIC_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# System Safeguarding & Audit
NODE_ENV="production"
PRACTICUM_AUDIT_ENABLED="true"
SCOPEGUARD_ENFORCEMENT_LEVEL="STRICT"
